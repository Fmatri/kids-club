# Adresse de la base MongoDB (voir compose.yaml)
MONGODB_URI=mongodb://localhost:27017/kids-club?replicaSet=rs0

# Clé secrète de Better Auth (au moins 32 caractères). Pour en générer une :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=une_cle_generee

# Adresse du site
BETTER_AUTH_URL=http://localhost:3000